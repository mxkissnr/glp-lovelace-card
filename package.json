{
  "name": "glp-lovelace-card",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=json-summary --check-coverage --include='src/**' --lines=61 node --test",
    "build": "esbuild src/glp-card.ts --bundle --format=iife --target=es2022 --charset=utf8 --keep-names --preserve-symlinks --banner:js=\"// Generated from src/ by npm run build. Do not edit this file.\" --outfile=glp-card.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "screenshot": "node scripts/screenshot.mts",
    "sync-to-integration": "bash scripts/sync-to-integration.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.1",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "happy-dom": "20.14.5",
    "lit": "3.3.3",
    "playwright": "^1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
